<%@ page language="java" contentType="text/html; charset=UTF-8"  pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>About - Pawsy Paila</title>
    <link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/about.css">
    <link rel="stylesheet" type="text/css" href="${pageContext.request.contextPath}/css/header.css">
</head>
<body>

<!-- HEADER INCLUDE -->


<!-- OUR STORY SECTION -->
<section class="story-section">
    <h1>Our Story</h1>

    <div class="story-container">

        <div class="story-left">
            <div class="big-text-box">
                At Pawsy Paila, we believe that every pet deserves a loving family.
            </div>

            <div class="small-text-box">
                Our platform was created with a mission to connect animals in need with caring people, while also making pet care easy, accessible, and enjoyable.
            </div>
        </div>

        <div class="story-right">
            <img src="images/cat.png" alt="Cat">
        </div>

    </div>

    <div class="story-bottom">

        <div class="dog-image">
            <img src="images/dog.png" alt="Dog">
        </div>

        <div class="bottom-texts">
            <div class="small-text-box">
                Alongside adoption, we also provide a wide range of pet products. From nutritious food to fun toys and essential accessories, so you can give your pets the love and care they deserve.
            </div>

            <div class="small-text-box">
                At our core, we stand for compassion, responsibility, and the belief that every small step can make a big difference in an animal’s life.
            </div>
        </div>

    </div>
</section>

<!-- TEAM SECTION -->
<section class="team-section">
    <h1>Our Team</h1>

    <div class="team-container">

        <div class="team-card">
            <div class="team-img">
                <img src="images/slesha.png" alt="Slesha">
            </div>
            <h3>Slesha Maharjan</h3>
            <p>Head Director</p>
        </div>

        <div class="team-card">
            <div class="team-img">
                <img src="images/yunisha.png" alt="Yunisha">
            </div>
            <h3>Yunisha Basnet</h3>
            <p>Head of Product</p>
        </div>

        <div class="team-card">
            <div class="team-img">
                <img src="images/swornima.png" alt="Swornima">
            </div>
            <h3>Swornima Maharjan</h3>
            <p>Managing Director</p>
        </div>

        <div class="team-card">
            <div class="team-img">
                <img src="images/sulove.png" alt="Sulove">
            </div>
            <h3>Sulove Noko Shrestha</h3>
            <p>Head of Creative</p>
        </div>

        <div class="team-card">
            <div class="team-img">
                <img src="images/swoyam.png" alt="Swoyam">
            </div>
            <h3>Swoyam Maharjan</h3>
            <p>Director of Sales</p>
        </div>

    </div>
</section>

</body>
</html>